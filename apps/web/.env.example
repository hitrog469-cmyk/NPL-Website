# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server-only. Never expose to the browser or paste in chat.
SUPABASE_SECRET_KEY=
# Local only, for scripts/db-setup.ts. Never add to Vercel or paste in chat.
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=
